{
    "problemMatcher": [
        {
            "owner": "cafe-gcc-clang",
            "pattern": [
                {
                    "regexp": "^(.+?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            ]
        },
        {
            "owner": "cafe-msvc",
            "pattern": [
                {
                    "regexp": "^(?:\\s*\\d+>)?([^\\s].*?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s+(?:fatal\\s+)?(error)\\s+(\\w+\\d+)\\s*:\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            ]
        },
        {
            "owner": "cafe-nvcc",
            "pattern": [
                {
                    "regexp": "^(?:\\s*\\d+>)?([^\\s].*?)\\((\\d+)\\):\\s+(error)\\s*:?\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            ]
        },
        {
            "owner": "cafe-killed",
            "pattern": [
                {
                    "regexp": "^(.*(?:Killed signal terminated program|internal compiler error|virtual memory exhausted|out of memory|make(?:\\[\\d+\\])?: \\*\\*\\*).*)$",
                    "message": 1
                }
            ]
        },
        {
            "owner": "cafe-cmake",
            "pattern": [
                {
                    "regexp": "^CMake Error(?: at (.+?):(\\d+))?.*$",
                    "file": 1,
                    "line": 2
                },
                {
                    "regexp": "^\\s+(.+)$",
                    "message": 1
                }
            ]
        },
        {
            "owner": "cafe-linker",
            "pattern": [
                {
                    "regexp": "^(.*(?:undefined reference|undefined symbol|unresolved external symbol|ld: |LNK\\d+|nvcc fatal|ninja: build stopped|error: linker command failed).*)$",
                    "message": 1
                }
            ]
        }
    ]
}
