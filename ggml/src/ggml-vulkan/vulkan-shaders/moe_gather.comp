#version 450

// copy the routed experts of a MUL_MAT_ID into a device buffer, from the VRAM cache when the
// expert is resident and from pinned host memory otherwise
// compact: route r gets slot r, routes that repeat an expert point to the first route of that expert
// dense:   expert e stays at slot e and the ids are unchanged

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly  buffer S {uint data_s[];}; // pinned host experts
layout (binding = 1) readonly  buffer I {int  data_i[];}; // routed ids
layout (binding = 2) writeonly buffer D {uint data_d[];}; // device copy
layout (binding = 3) writeonly buffer R {int  data_r[];}; // rewritten ids
layout (binding = 4) readonly  buffer T {int  data_t[];}; // cache slot of each expert, -1 when not resident
layout (binding = 5) readonly  buffer P {uint data_p[];}; // cache pool
layout (binding = 6)           buffer C {uint data_c[];}; // uses of each expert, read by the host
layout (binding = 7) readonly  buffer H {uint data_h[];}; // host split state, see moe_cpu_publish.comp

layout (push_constant) uniform parameter {
    uint expert_words;
    uint n_ids;
    uint n_tok;
    uint ids_nb0;
    uint ids_nb1;
    uint ids_offset;
    uint n_expert;
    uint src_offset;
    uint compact;
    uint cpu_split;
} p;

bool host_route(uint r) {
    return p.cpu_split != 0 && data_h[256 + r] != 0;
}

int route_expert(uint r) {
    return data_i[p.ids_offset + (r / p.n_ids) * p.ids_nb1 + (r % p.n_ids) * p.ids_nb0];
}

void main() {
    const uint r = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    if (r >= p.n_ids * p.n_tok) {
        return;
    }
    const int e = route_expert(r);

    // first route with this expert that the GPU computes; only that route copies the expert
    uint first = r;
    if (p.compact != 0 && !host_route(r)) {
        for (uint q = 0; q < r; ++q) {
            if (route_expert(q) == e && !host_route(q)) {
                first = q;
                break;
            }
        }
    }
    if (p.compact != 0 && gl_GlobalInvocationID.x == 0) {
        data_r[r] = int(first);
    }
    if (e < 0 || uint(e) >= p.n_expert) {
        return;
    }
    if (gl_GlobalInvocationID.x == 0) {
        atomicAdd(data_c[uint(e)], 1u);
    }

    // the host workers compute this route, the merge overwrites its rows
    if (host_route(r) || first != r) {
        return;
    }

    const int  slot = data_t[uint(e)];
    const uint dst  = (p.compact != 0 ? r : uint(e)) * p.expert_words;
    const uint step = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    if (slot >= 0) {
        const uint src = uint(slot) * p.expert_words;
        for (uint i = gl_GlobalInvocationID.x; i < p.expert_words; i += step) {
            data_d[dst + i] = data_p[src + i];
        }
    } else {
        const uint src = p.src_offset + uint(e) * p.expert_words;
        for (uint i = gl_GlobalInvocationID.x; i < p.expert_words; i += step) {
            data_d[dst + i] = data_s[src + i];
        }
    }
}
